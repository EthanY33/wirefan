[Unit]
Description=wirefan WebSocket fanout server
After=network.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wirefan
EnvironmentFile=-/etc/wirefan/env
Restart=on-failure
RestartSec=5
User=wirefan
Group=wirefan

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Persistent volume for sqlite db (operator must create this dir + chown to wirefan)
ReadWritePaths=/var/lib/wirefan
WorkingDirectory=/var/lib/wirefan

[Install]
WantedBy=multi-user.target

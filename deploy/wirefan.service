[Unit]
Description=wirefan WebSocket fanout server
After=network.target
Wants=network-online.target

[Service]
Type=simple
# --allowed-origins is required and refuses '*' outside --dev: the
# wirefan.example.com placeholder is substituted by deploy/provision.sh
# (--domain), or replace it by hand with the origin(s) your browser clients
# load from. The admin
# listener stays on loopback so /v1/keys, /metrics, and /debug/pprof are
# never internet-reachable; mint keys from the host itself.
ExecStart=/usr/local/bin/wirefan \
    --listen=:8080 \
    --admin-addr=127.0.0.1:6060 \
    --allowed-origins=https://wirefan.example.com \
    --db-path=/var/lib/wirefan/wirefan.db
# State dir holds admin.token (and the SQLite db unless --db-path moves it).
Environment=WIREFAN_STATE_DIR=/var/lib/wirefan
# Optional overrides (WIREFAN_TRUSTED_PROXIES etc.); see deploy/.env.example.
EnvironmentFile=-/etc/wirefan/env
Restart=on-failure
RestartSec=5
User=wirefan
Group=wirefan

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Persistent volume for sqlite db (operator must create this dir + chown to wirefan)
ReadWritePaths=/var/lib/wirefan
WorkingDirectory=/var/lib/wirefan

[Install]
WantedBy=multi-user.target

# /etc/wirefan/env — sourced by systemd EnvironmentFile=
# Copy this to /etc/wirefan/env on the server and fill in values.
# Permissions: chmod 0600, chown wirefan:wirefan

# OTel endpoint — leave empty to keep tracing dormant.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Admin token override (optional). If set, wirefan uses this instead of
# generating a fresh one each boot. Important for ops continuity.
# WIREFAN_ADMIN_TOKEN=

# HMAC signing secret. If set, wirefan uses this instead of generating a
# fresh one each boot. CRITICAL: setting this means tokens issued by previous
# instances stay valid across restarts.
# WIREFAN_SIGNING_SECRET=

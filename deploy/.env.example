# wirefan environment template.
# systemd: copy to /etc/wirefan/env (mode 0600), sourced by wirefan.service.
# Docker:  pass with `docker run --env-file`.
# Every entry is optional; the commented value is the default behavior.

# Admin Bearer token for /v1/keys on the admin listener. If unset, wirefan
# generates one on first boot and persists it at $WIREFAN_STATE_DIR/admin.token
# (mode 0600, reused on later boots, never logged). Set it only if you want to
# manage the value yourself.
#WIREFAN_ADMIN_TOKEN=

# Directory for the admin token file and the default SQLite db path.
# Defaults to ./var relative to the working directory. The shipped systemd
# unit and Dockerfile both set this to /var/lib/wirefan.
#WIREFAN_STATE_DIR=/var/lib/wirefan

# Comma-separated list of proxy IPs/CIDRs whose X-Forwarded-For header is
# trusted when attributing a connection to a client IP.
#
# FOOTGUN: wirefan caps concurrent connections per client IP (200 by
# default). Behind a reverse proxy with this unset, every connection appears
# to come from the proxy's IP, so the per-IP cap silently becomes a GLOBAL
# 200-connection ceiling: connection 201 is rejected no matter who it is.
# If wirefan sits behind Caddy/nginx/etc., set this to the proxy's address.
#
#   Caddy on the same host, wirefan as a native binary:  127.0.0.1
#   Caddy on the host, wirefan in Docker (default bridge): 172.17.0.0/16
#
# Malformed entries are silently dropped, so smoke-test after setting it.
WIREFAN_TRUSTED_PROXIES=127.0.0.1

# Per-client-IP concurrent connection cap. Default 200. Raise for load tests
# or many-clients-behind-one-NAT deployments.
#WIREFAN_IP_CAP=200

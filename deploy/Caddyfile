# deploy/Caddyfile
# Caddy reverse proxy fronting wirefan with auto-Let's Encrypt TLS.
# Replace wirefan.ethanyucetepe.dev with your actual hostname.

wirefan.ethanyucetepe.dev {
    encode gzip

    # Forward the client IP for wirefan's per-IP connection cap. wirefan only
    # trusts X-Forwarded-For from addresses listed in the WIREFAN_TRUSTED_PROXIES
    # env var (see deploy/.env.example) — set it to this proxy's address, or
    # every connection is attributed to the proxy IP and the per-IP cap
    # becomes a global ceiling.
    reverse_proxy localhost:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        flush_interval -1
    }

    # Block direct localhost access to internal endpoints from the public domain.
    @internal path /debug/pprof*
    respond @internal "Not Found" 404
}

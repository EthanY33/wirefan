# Admin tokens copied out of a state dir (deploy/README.md's docker cp
# smoke test writes ./admin.token)
*.token
# Runtime state directory (admin token, sqlite db, etc, written at boot).
# The default is ./var relative to the working directory, so running from
# the repo root creates /var and running from cmd/wirefan creates its own.
/var/
cmd/wirefan/var/

# Profiles
*.prof
docs/profiles/*.png
!docs/profiles/.gitkeep

# Build (`go build ./cmd/<name>` from the repo root drops the binary here)
/relay
/loadtest
/wirefan

# Benchmark outputs
/results/

# thryv-onboard skill scratch (recon notes, draft CLAUDE.md)
.thryv-onboard/
# Serena MCP per-project metadata
.serena/

# Agent worktrees and session scratch
.claude/
